{{!
    @template qtype_drawing/drawingarea

    Template purpose and description.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}

<style>
    *, *::before, *::after {
        box-sizing: content-box !important;
    }

    .visually-hidden-focusable {
        display: none;
    }

    .qtype_drawing_selectedcolor {
        outline: 2px #4F80FF solid !important;
    }

    .qtype_drawing_color_divsquare {
        width: 21px;
        height: 21px;
        margin: 4px;
        border: 0px solid black;
        float: left;
        cursor: pointer;
        cursor: hand;
    }

    .qtype_drawing_color_pallette {
        width: 21px;
        height: 21px;
        margin: 4px;
        border: 0px solid black;
        float: left;
        cursor: pointer;
        cursor: hand;
    }

    .divSquarebrush {
        width: 35%;
        height: 20px;
        margin: 4px;
        border: 0px solid black;
        float: left;
        cursor: pointer;
        cursor: hand;
    }

    .qtype_drawing_size_pen {
        position: relative;
        width: 25px;
        height: 20px;
        margin: 4px;
        border: 0px solid white;
        float: left;
        cursor: pointer;
        cursor: hand;
    }

    .circleBase {
        border-radius: 50%;
        behavior: url(PIE.htc);
        margin: 5px;
    }

    .type1 {
        width: 3px;
        height: 3px;
        background: #ddd;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .type2 {
        width: 5px;
        height: 5px;
        background: #ddd;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .type3 {
        width: 10px;
        height: 10px;
        background: #ddd;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .type4 {
        width: 15px;
        height: 15px;
        background: #ddd;
        position: absolute;
        top: 80%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .type5 {
        width: 20px;
        height: 20px;
        background: #ddd;
        position: absolute;
        top: 80%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .type6 {
        width: 30px;
        height: 30px;
        background: #ddd;
        position: absolute;
        top: 80%;
        left: 80%;
        transform: translate(-50%, -50%);
    }

    .qtype_drawing_active_selection {
        background-color: #0cf;
    }

    .qtype_drawing_active_selection_border {
        border: 2px solid #0cf;
    }

    #svg_editor .jPicker td.Radio input {
        margin: 0 2px 0 0;
    }

    html {
        height: 100%;
        overflow: hidden;
    }

    body {
        height: 100%;
        overflow: auto;
    }

    @media screen and (-webkit-min-device-pixel-ratio: 0) {
        select,
        textarea,
        input {
            font-size: 16px;
        }
    }

    #question_text-holder {
        background-color: #fff;
        padding: 10px;
        box-sizing: border-box !important;
    }

    #question_drawing {
        position: relative;
    }
</style>
{{#questionembed}}
    <div id="question_text-holder">
        {{{questiontext}}}
    </div>
{{/questionembed}}
<div id="question_drawing">
    <div id="svg_editor">
        <div id="rulers">
            <div id="ruler_corner"></div>
            <div id="ruler_x">
                <div id="ruler_x_cursor"></div>
                <div>
                    <canvas height="15"></canvas>
                </div>
            </div>
            <div id="ruler_y">
                <div id="ruler_y_cursor"></div>
                <div>
                    <canvas width="15"></canvas>
                </div>
            </div>
        </div>
        <div id="workarea" style="touch-action:none;">
            <div id="svgcanvas" style="position:relative">
            </div>
        </div>
        <div id="menu_bar">
            <a class="menu">
                <div class="menu_list">
                    <div id="tool_about" class="menu_item"></div>
                    <div class="separator"></div>
                    <div id="tool_about" class="menu_item">Keyboard Shortcuts...</div>
                </div>
            </a>
            <div class="menu">
                <div class="menu_title">{{#str}}file,qtype_drawing{{/str}}</div>
                <div class="menu_list" id="file_menu">
                    <div id="tool_clear" class="menu_item">{{#str}}erasedrawing,qtype_drawing{{/str}}</div>
                </div>
            </div>
            <div class="menu">
                <div class="menu_title">{{#str}}edit,qtype_drawing{{/str}}</div>
                <div class="menu_list" id="edit_menu">
                    <div class="separator"></div>
                    <div class="menu_item action_selected disabled"
                         id="tool_cut">{{#str}}cut,qtype_drawing{{/str}} <span class="shortcut">⌘X</span></div>
                    <div class="menu_item action_selected disabled"
                         id="tool_copy">{{#str}}copy,qtype_drawing{{/str}} <span class="shortcut">⌘C</span></div>
                    <div class="menu_item action_selected disabled"
                         id="tool_paste">{{#str}}paste,qtype_drawing{{/str}} <span class="shortcut">⌘V</span></div>
                    <div class="menu_item action_selected disabled"
                         id="tool_clone">{{#str}}duplicate,qtype_drawing{{/str}} <span class="shortcut">⌘D</span></div>
                    <div class="menu_item action_selected disabled"
                         id="tool_delete">{{#str}}delete,qtype_drawing{{/str}} <span>⌫</span></div>
                </div>
            </div>
            <div class="menu">
                <div class="menu_title">{{#str}}object,qtype_drawing{{/str}}</div>
                <div class="menu_list" id="object_menu">
                    <div class="menu_item action_selected disabled"
                         id="tool_move_top">{{#str}}bringtofront,qtype_drawing{{/str}}
                        <span class="shortcut">⌘⇧↑</span></div>
                    <div class="menu_item action_selected disabled"
                         id="tool_move_up">{{#str}}bringforward,qtype_drawing{{/str}}
                        <span class="shortcut">⌘↑</span></div>
                    <div class="menu_item action_selected disabled"
                         id="tool_move_down">{{#str}}sendbackward,qtype_drawing{{/str}}
                        <span class="shortcut">⌘↓</span></div>
                    <div class="menu_item action_selected disabled"
                         id="tool_move_bottom">{{#str}}sendtoback,qtype_drawing{{/str}}
                        <span class="shortcut">⌘⇧↓</span></div>
                    <div class="separator"></div>
                    <div class="menu_item action_multi_selected disabled"
                         id="tool_group">{{#str}}groupelements,qtype_drawing{{/str}}
                        <span class="shortcut">⌘G</span></div>
                    <div class="menu_item action_group_selected disabled"
                         id="tool_ungroup">{{#str}}ungroupelements,qtype_drawing{{/str}}
                        <span class="shortcut">⌘⇧G</span></div>
                    <div class="menu_item action_path_convert_selected disabled"
                         id="tool_topath" style="display:none;">{{#str}}converttopath,qtype_drawing{{/str}}</div>
                    <div class="menu_item action_path_selected disabled"
                         id="tool_reorient" style="display:none;">{{#str}}reorientpath,qtype_drawing{{/str}}</div>
                </div>
            </div>
            <div class="menu">
                <div class="menu_title">{{#str}}view,qtype_drawing{{/str}}</div>
                <div class="menu_list" id="view_menu">
                    <div class="menu_item push_button_pressed"
                         id="tool_rulers">{{#str}}viewrulers,qtype_drawing{{/str}}</div>
                    <div class="menu_item"
                         id="tool_wireframe" style="display:none">{{#str}}viewwireframe,qtype_drawing{{/str}}</div>
                    <div class="menu_item"
                         id="tool_snap">{{#str}}snaptogrid,qtype_drawing{{/str}}</div>
                    <div class="separator"></div>
                    <div class="menu_item"
                         id="tool_source">{{#str}}source,qtype_drawing{{/str}} <span class="shortcut">⌘U</span></div>
                </div>
            </div>
        </div>
        <div id="tools_top" class="tools_panel">
            {{#useupdateannotationjs}}
                <div id="annotation_panel" class="context_panelv">
                    <h4>{{#str}}annotation,qtype_drawing{{/str}}</h4>
                    <div class="annotation_tool draginput" style="width:145px;padding-bottom:2px; height:100%"
                         id="annotation_tool">
                      <span><input type="button" name="saveannotation" id="tool_saveannotation"
                                   value="{{#str}}saveannotation,qtype_drawing{{/str}}"
                                   style="background: #4F80FF;
                                          color: #fff;
                                          border-radius: 3px;
                                          padding: 1px 14px;
                                          border: none;
                                          line-height: 140%;
                                          font-size: 14px;
                                          font-weight: bold;
                                          font-family: sans-serif;
                                          white-space: normal;
                                          height:initial;">
                      </span>
                        <div style="padding:20px"></div>
                        <div id="teacherannotations"
                             style="margin-top:10px;
                                  color: #4F80FF;
                                  font-size:12px;
                                  margin-left:-20px;
                                  margin-right:1px;
                                  text-align:left">
                            <ul id="listofannotaions">
                                {{#annotations_list}}
                                    <li id="annotationelem_{{userid}}" class="annotaionelems"
                                        data-block="block{{userid}}">
                                        <a href="#" id="showannotationid_{{id}}" style="color:#fff"
                                           class="tool_showannotation" data-type="0"
                                           data-annotationid="{{id}}">{{username}}</a>
                                        <div id="teacherannotationdate_{{userid}}">{{date}}{{ago}}</div>
                                    </li>
                                {{/annotations_list}}
                                <li data-block="block0">
                                    <a href="#" id="showoriginalanswer" style="color:#fff"
                                       class="tool_showannotation" data-type="1"
                                       data-annotationid="-1">{{#str}}originalanswer,qtype_drawing{{/str}}</a>
                                </li>
                                <li data-block="block1" onclick="methodDraw.updateAnnotationDetails()">
                                    <a href="#" id="studentview" style="color:#fff" class="tool_showannotation"
                                       data-type="2" data-annotationid="-1">{{#str}}studentview,qtype_drawing{{/str}}</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            {{/useupdateannotationjs}}
            <div id="canvas_panel" class="context_panel">

                <div class="clearfix"></div>
                <h4>{{#str}}drawingpresets,qtype_drawing{{/str}}</h4>
                <div class="stroke_tool draginput" style="width:145px;padding-bottom:2px; height:100%"
                     id="fastcolorpicks">

                    <span>{{#str}}color:stroke,qtype_drawing{{/str}}</span>
                    <div style="margin-top:15px; text-align:center;">
                        {{#colors}}
                            <div id="qtype_drawing_tool_color{{colorid}}"
                                 class="qtype_drawing_color_divsquare {{#selected}}qtype_drawing_selectedcolor{{/selected}}"
                                 data-strokeorfill="stroke" style="background:{{hex}}"></div>
                        {{/colors}}
                    </div>
                </div>
                <div class="stroke_tool draginput" style="width:145px;padding-bottom:2px; height:100%; display:none;"
                     id="fastcolorfillpicks">

                    <span>{{#str}}color:fill,qtype_drawing{{/str}}</span>
                    <div style="margin-top:15px; text-align:center;">
                        {{#colors}}
                            <div id="qtype_drawing_tool_fillcolor{{colorid}}f"
                                 class="qtype_drawing_color_divsquare"
                                 data-strokeorfill="fill" style="background:{{hex}}"></div>
                        {{/colors}}
                    </div>
                </div>
                <div class="stroke_tool draginput" style="width:145px;padding-bottom:2px; height:100%; display: none; "
                     id="fastcolorhighlighterpicks">

                    <span>{{#str}}color:highlighter,qtype_drawing{{/str}}</span>
                    <div style="margin-top:15px; text-align:center;">
                        <div id="qtype_drawing_tool_color_highlighter"
                             class="qtype_drawing_color_divsquare"
                             data-strokeorfill="stroke" style="background: {{colorhighlighter}};"></div>
                    </div>
                </div>
                <div class="stroke_tool draginput" id="preset_sizes_panel_id"
                     style="width:125px;padding:10px; height:70px">
                    <span>{{#str}}size,qtype_drawing{{/str}}</span>
                    <div>
                        <div id="qtype_drawing_tool_pensize1"
                             class="qtype_drawing_size_pen" data-size="1.5" data-penortext="pen" title="1px">
                            <div class="circleBase type1"></div>
                        </div>
                        <div id="qtype_drawing_tool_pensize2"
                             class="qtype_drawing_size_pen" data-size="2.5" data-penortext="pen" title="2px">
                            <div class="circleBase type2"></div>
                        </div>
                        <div id="qtype_drawing_tool_pensize3"
                             class="qtype_drawing_size_pen" data-size="3.5" data-penortext="pen" title="3px">
                            <div class="circleBase type3 qtype_drawing_active_selection"></div>
                        </div>
                        <div style='clear:both'></div>
                        <div id="qtype_drawing_tool_pensize4"
                             class="qtype_drawing_size_pen" data-size="5" data-penortext="pen" title="5px">
                            <div class="circleBase type4"></div>
                        </div>
                        <div id="qtype_drawing_tool_pensize5"
                             class="qtype_drawing_size_pen" data-size="10" data-penortext="pen" title="10px">
                            <div class="circleBase type5"></div>
                        </div>
                        <div id="qtype_drawing_tool_pensize6"
                             class="qtype_drawing_size_pen" data-size="20" data-penortext="pen" title="20px">
                            <div class="circleBase type6"></div>
                        </div>
                    </div>
                </div>
                <div id="stroke_panel" class=" clearfix">
                    <div class="clearfix"></div>
                    <div class="toolset" data-title="{{#str}}changestroke,qtype_drawing{{/str}}" id="strokewidth_div">
                        <label>
                            <input id="stroke_width" type="number" size="2" value="5" data-attr="stroke-width" min="1"
                                   max="99" step="1"/>
                            <span class="icon_label">{{#str}}strokewidth,qtype_drawing{{/str}}</span>
                        </label>
                    </div>
                    <div id="where_iwant_tool_opacity"></div>
                    <div class="stroke_tool draginput" id="strokestyle_div">
                        <span>{{#str}}strokedash,qtype_drawing{{/str}}</span>
                        <select id="stroke_style" data-title="{{#str}}dashstyle,qtype_drawing{{/str}}">
                            <option selected="selected" value="none">—</option>
                            <option value="2,2">···</option>
                            <option value="5,5">- -</option>
                            <option value="5,2,2,2">-·-</option>
                            <option value="5,2,2,2,2,2">-··-</option>
                        </select>
                        <div class="caret"></div>
                        <label id="stroke_style_label">—</label>
                    </div>
                    <span style="display:none">
                      <h4 class="clearfix">&nbsp;</h4>
                      <label data-title="Change canvas width">
                      <input size="3" id="canvas_width" type="text" pattern="[0-9]*"/>
                      <span class="icon_label">Width</span>
                      </label>
                      <label data-title="Change canvas height">
                      <input id="canvas_height" size="3" type="text" pattern="[0-9]*"/>
                      <span class="icon_label">Height</span>
                      </label>
                      <label data-title="Change canvas color" class="draginput">
                         <span>Color</span>
                         <div id="color_canvas_tools">
                            <div class="color_tool active" id="tool_canvas">
                               <div class="color_block">
                                  <div id="canvas_bg"></div>
                                  <div id="canvas_color"></div>
                               </div>
                            </div>
                         </div>
                      </label>
                      <div class="draginput">
                         <span>Sizes</span>
                         <select id="resolution">
                            <option id="selectedPredefined" selected="selected">Custom</option>
                            <option>640x480</option>
                            <option>800x600</option>
                            <option>1024x768</option>
                            <option>1280x960</option>
                            <option>1600x1200</option>
                            <option id="fitToContent" value="content">Fit to Content</option>
                         </select>
                         <div class="caret"></div>
                         <label id="resolution_label">Custom</label>
                      </div>
                   </span>
                </div>
            </div>
            <div id="selected_panel" class="context_panel">
                <label id="tool_angle" data-title="{{#str}}changerotationangle,qtype_drawing{{/str}}"
                       class="draginput" {{{displaystylefull}}}>
                    <input id="angle" class="attr_changer" size="2" value="0" data-attr="transform"
                           data-min="-180" data-max="180" type="text"/>
                    <span class="icon_label">{{#str}}rotation,qtype_drawing{{/str}}</span>
                    <div id="tool_angle_indicator">
                        <div id="tool_angle_indicator_cursor"></div>
                    </div>
                </label>
                <div id="dat_tool_opacity_pain"  {{{displaystylefull}}}>
                    <div class="clearfix"></div>
                    <label class="toolset" id="tool_opacity" data-title="{{#str}}changeopacity,qtype_drawing{{/str}}">
                        <input id="group_opacity" class="attr_changer" data-attr="opacity"
                               data-multiplier="0.01" size="3" value="100" step="5" min="0" max="100"/>
                        <span id="group_opacityLabel" class="icon_label">{{#str}}opacity,qtype_drawing{{/str}}</span>
                    </label>
                </div>
                <div class="toolset" id="tool_blur"
                     data-title="{{#str}}changeblur,qtype_drawing{{/str}}"  {{{displaystylefull}}}>
                    <label>
                        <input id="blur" size="2" value="0" step=".1" min="0" max="10"/>
                        <span class="icon_label">{{#str}}blur,qtype_drawing{{/str}}</span>
                    </label>
                    <div class="clearfix"></div>
                </div>
                <label id="cornerRadiusLabel"
                       data-title="{{#str}}changecornerradius,qtype_drawing{{/str}}"  {{{displaystylefull}}}>
                    <input id="rect_rx" size="3" value="0" data-attr="rx" class="attr_changer" type="text"
                           pattern="[0-9]*"/>
                    <span class="icon_label">{{#str}}roundness,qtype_drawing{{/str}}</span>
                </label>
                <div id="align_tools"  {{{displaystylefull}}}>
                    <div class="clearfix"></div>
                    <h4>{{#str}}align,qtype_drawing{{/str}}</h4>
                    <div class="toolset align_buttons" id="tool_position">
                        <label>
                            <div class="col last clear" id="position_opts">
                                <div class="draginput_cell" id="tool_posleft" title="Align Left"></div>
                                <div class="draginput_cell" id="tool_poscenter" title="Align Center"></div>
                                <div class="draginput_cell" id="tool_posright" title="Align Right"></div>
                                <div class="draginput_cell" id="tool_postop" title="Align Top"></div>
                                <div class="draginput_cell" id="tool_posmiddle" title="Align Middle"></div>
                                <div class="draginput_cell" id="tool_posbottom" title="Align Bottom"></div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>
            <div id="rect_panel" class="context_panel">
                <h4 class="clearfix">{{#str}}rectangle,qtype_drawing{{/str}}</h4>
                <label>
                    <input id="rect_x" class="attr_changer" data-title="Change X coordinate" size="3" data-attr="x"
                           pattern="[0-9]*"/>
                    <span>X</span>
                </label>
                <label>
                    <input id="rect_y" class="attr_changer" data-title="Change Y coordinate" size="3" data-attr="y"
                           pattern="[0-9]*"/>
                    <span>Y</span>
                </label>
                <label id="rect_width_tool attr_changer" data-title="Change rectangle width">
                    <input id="rect_width" class="attr_changer" size="3" data-attr="width" type="text"
                           pattern="[0-9]*"/>
                    <span class="icon_label">{{#str}}width,qtype_drawing{{/str}}</span>
                </label>
                <label id="rect_height_tool" data-title="Change rectangle height">
                    <input id="rect_height" class="attr_changer" size="3" data-attr="height" type="text"
                           pattern="[0-9]*"/>
                    <span class="icon_label">{{#str}}height,qtype_drawing{{/str}}</span>
                </label>
            </div>
            <div id="path_panel" class="context_panel clearfix"   {{{displaystylefull}}}>
                <h4 class="clearfix">{{#str}}path,qtype_drawing{{/str}}</h4>
                <label>
                    <input id="path_x" class="attr_changer"
                           data-title="Change ellipse's cx coordinate" size="3" data-attr="x" pattern="[0-9]*"/>
                    <span>X</span>
                </label>
                <label>
                    <input id="path_y" class="attr_changer"
                           data-title="Change ellipse's cy coordinate" size="3" data-attr="y" pattern="[0-9]*"/>
                    <span>Y</span>
                </label>
            </div>
            <div id="image_panel" class="context_panel clearfix">
                <h4>{{#str}}image,qtype_drawing{{/str}}</h4>
                <label>
                    <input id="image_x" class="attr_changer" data-title="Change X coordinate" size="3" data-attr="x"
                           pattern="[0-9]*"/>
                    <span>X</span>
                </label>
                <label>
                    <input id="image_y" class="attr_changer" data-title="Change Y coordinate" size="3" data-attr="y"
                           pattern="[0-9]*"/>
                    <span>Y</span>
                </label>
                <label>
                    <input id="image_width" class="attr_changer"
                           data-title="Change image width" size="3" data-attr="width" pattern="[0-9]*"/>
                    <span class="icon_label">Width</span>
                </label>
                <label>
                    <input id="image_height" class="attr_changer"
                           data-title="Change image height" size="3" data-attr="height" pattern="[0-9]*"/>
                    <span class="icon_label">Height</span>
                </label>
            </div>
            <div id="circle_panel" class="context_panel">
                <h4>{{#str}}circle,qtype_drawing{{/str}}</h4>
                <label id="tool_circle_cx">
                    <span>{{#str}}centerx,qtype_drawing{{/str}}</span>
                    <input id="circle_cx" class="attr_changer" title="Change circle's cx coordinate" size="3"
                           data-attr="cx"/>
                </label>
                <label id="tool_circle_cy">
                    <span>{{#str}}centery,qtype_drawing{{/str}}</span>
                    <input id="circle_cy" class="attr_changer" title="Change circle's cy coordinate" size="3"
                           data-attr="cy"/>
                </label>
                <label id="tool_circle_r">
                    <span>Radius</span>
                    <input id="circle_r" class="attr_changer" title="Change circle's radius" size="3" data-attr="r"/>
                </label>
            </div>
            <div id="ellipse_panel" class="context_panel clearfix">
                <h4>{{#str}}ellipse,qtype_drawing{{/str}}</h4>
                <label id="tool_ellipse_cx">
                    <input id="ellipse_cx" class="attr_changer"
                           data-title="Change ellipse's cx coordinate" size="3" data-attr="cx" pattern="[0-9]*"/>
                    <span>X</span>
                </label>
                <label id="tool_ellipse_cy">
                    <input id="ellipse_cy" class="attr_changer"
                           data-title="Change ellipse's cy coordinate" size="3" data-attr="cy" pattern="[0-9]*"/>
                    <span>Y</span>
                </label>
                <label id="tool_ellipse_rx">
                    <input id="ellipse_rx" class="attr_changer"
