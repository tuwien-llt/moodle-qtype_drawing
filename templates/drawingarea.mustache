<script>
        {{#js}}
        require(['qtype_drawing/drawingarea'], function (DrawingArea) {
            DrawingArea.init({
                str: {
                    comment: "{{#str}}drawingcomment,qtype_drawing{{/str}}",
                    newconfirmationmsg: "{{#str}}newconfirmationmsg,qtype_drawing{{/str}}",
                    eraseconfirmationmsg: "{{#str}}eraseconfirmationmsg,qtype_drawing{{/str}}",
                    parsingerror: "{{#str}}parsingerror,qtype_drawing{{/str}}",
                    ignorechanges: "{{#str}}ignorechanges,qtype_drawing{{/str}}",
                    ok: "{{#str}}ok,qtype_drawing{{/str}}",
                    cancel: "{{#str}}cancel,qtype_drawing{{/str}}",
                    eyedroppertool: "{{#str}}eyedroppertool,qtype_drawing{{/str}}",
                    shapelibrary: "{{#str}}shapelibrary,qtype_drawing{{/str}}",
                    drawmarkers: "{{#str}}drawmarkers,qtype_drawing{{/str}}",
                    solidcolor: "{{#str}}solidcolor,qtype_drawing{{/str}}",
                    lingrad: "{{#str}}lingrad,qtype_drawing{{/str}}",
                    radgrad: "{{#str}}radgrad,qtype_drawing{{/str}}",
                    new: "{{#str}}new,qtype_drawing{{/str}}",
                    current: "{{#str}}current,qtype_drawing{{/str}}",
                    viewgrid: "{{#str}}viewgrid,qtype_drawing{{/str}}",
                    annotationsaved: "{{#str}}annotationsaved,qtype_drawing{{/str}}",
                    saving: "{{#str}}saving,qtype_drawing{{/str}}",
                    saveannotation: "{{#str}}saveannotation,qtype_drawing{{/str}}"
                },
                baseurl: "{{base_url}}",
                //  fhd_display_mode: "{{reducedmode}}",
                questionid: {{id}},
                sesskey: "{{sesskey}}",
                stid: {{stid}},
                attemptid: "{{attemptid}}",
                attemptcount: {{attemptcount}},
                defaultpensize: {{defaultpensize}},
                uniquefieldnameattemptid: "{{uniquefieldnameattemptid}}",
                defaultColor: "{{defaultcolor.hex}}",
                colorhighlighter: "{{colorhighlighter}}",
            useupdateannotationjs: {{#useupdateannotationjs}}true{{/useupdateannotationjs}}{{^useupdateannotationjs}}false{{/useupdateannotationjs}}
            });
        });
        {{/js}}
</script>