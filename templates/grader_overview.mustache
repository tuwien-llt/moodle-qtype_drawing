{{!
    @template qtype_drawing/grader_overview

    Drawing question grader landing page. One row per drawing question
    slot in the quiz, with aggregate response/grading counts.

    Context variables required for this template:
    * quizname - The quiz name
    * groupmenu - Optional pre-rendered HTML for the group activity
                  menu (empty string when the quiz is not in group mode)
    * rows - Array of per-slot row objects: {questionname, slot,
             responsecount, totalstudents, totalattempts, tograde,
             graded, hasattempts, needsattention, actionurl}
    * hasrows - Boolean: at least one drawing slot exists
    * totalcount - Total drawing attempts across all slots
    * needsgradingcount - Drawing attempts still in needsgrading
    * gradedcount - Drawing attempts already graded
    * backurl - URL to go back to quiz grading report

    Example context (json):
    {
        "quizname": "Test Quiz",
        "hasrows": true,
        "totalcount": 25,
        "needsgradingcount": 5,
        "gradedcount": 20,
        "backurl": "/mod/quiz/report.php?id=1&mode=grading",
        "rows": [
            {
                "questionname": "Draw a house",
                "slot": 1,
                "responsecount": 37,
                "totalstudents": 42,
                "totalattempts": 45,
                "tograde": 3,
                "graded": 42,
                "hasattempts": true,
                "needsattention": true,
                "actionurl": "/mod/quiz/report.php?id=1&mode=drawing&slot=1&attemptid=10"
            }
        ]
    }
}}
<div class="qtype-drawing-grader-overview">
    {{! Header with navigation }}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">{{#str}}gradequestion, qtype_drawing{{/str}}</h2>
            <p class="text-muted mb-0">{{quizname}}</p>
        </div>
    </div>

    {{#groupmenu}}
    <div class="mb-3">{{{groupmenu}}}</div>
    {{/groupmenu}}

    {{! Statistics cards }}
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-warning">{{needsgradingcount}}</h5>
                    <p class="card-text">{{#str}}needsgrading, qtype_drawing{{/str}}</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-success">{{gradedcount}}</h5>
                    <p class="card-text">{{#str}}alreadygraded, qtype_drawing{{/str}}</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">{{totalcount}}</h5>
                    <p class="card-text">{{#str}}totalattempts, qtype_drawing{{/str}}</p>
                </div>
            </div>
        </div>
    </div>

    {{! Per-question rows }}
    {{#hasrows}}
    <div class="table-responsive">
        <table class="table table-striped table-hover qtype-drawing-overview-sortable">
            <thead class="table-light">
                <tr>
                    <th scope="col" data-sortable="text">{{#str}}question, core{{/str}}</th>
                    <th scope="col" data-sortable="numeric">{{#str}}slot, qtype_drawing{{/str}}</th>
                    <th scope="col" data-sortable="numeric">{{#str}}responses, qtype_drawing{{/str}}</th>
                    <th scope="col" data-sortable="numeric">{{#str}}totalattempts, qtype_drawing{{/str}}</th>
                    <th scope="col" data-sortable="numeric">{{#str}}tograde, qtype_drawing{{/str}}</th>
                    <th scope="col" data-sortable="numeric">{{#str}}alreadygraded, qtype_drawing{{/str}}</th>
                    <th scope="col">{{#str}}actions, core{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr>
                    <td>{{questionname}}</td>
                    <td data-sortvalue="{{slot}}">{{slot}}</td>
                    <td data-sortvalue="{{responsecount}}">{{responsecount}}/{{totalstudents}}</td>
                    <td data-sortvalue="{{totalattempts}}">{{totalattempts}}</td>
                    <td data-sortvalue="{{tograde}}">
                        {{#needsattention}}<span class="badge text-bg-warning">{{tograde}}</span>{{/needsattention}}
                        {{^needsattention}}{{tograde}}{{/needsattention}}
                    </td>
                    <td data-sortvalue="{{graded}}">{{graded}}</td>
                    <td>
                        {{#hasattempts}}
                        <a href="{{actionurl}}" class="btn btn-sm {{#needsattention}}btn-primary{{/needsattention}}{{^needsattention}}btn-outline-secondary{{/needsattention}}">
                            {{#needsattention}}
                                {{#pix}}i/grades, core{{/pix}}
                                {{#str}}startgrading, qtype_drawing{{/str}}
                            {{/needsattention}}
                            {{^needsattention}}
                                {{#pix}}i/preview, core{{/pix}}
                                {{#str}}reviewquestion, qtype_drawing{{/str}}
                            {{/needsattention}}
                        </a>
                        {{/hasattempts}}
                        {{^hasattempts}}
                        <span class="text-muted">&mdash;</span>
                        {{/hasattempts}}
                    </td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
    {{/hasrows}}

    {{^hasrows}}
    <div class="alert alert-info">
        {{#pix}}i/info, core{{/pix}}
        {{#str}}noattempts, qtype_drawing{{/str}}
    </div>
    {{/hasrows}}
</div>
