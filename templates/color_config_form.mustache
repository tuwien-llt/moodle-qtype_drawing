{{!
    @template qtype_drawing/color_config_form

    Template purpose and description.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
        "uniqueid": "hfidshfisdy872"
    }
}}
<div class="color-config-wrapper" id="{{uniqueid}}">
    <div class="d-flex align-items-end mb-2 font-weight-bold">
        <div class="col-2 pl-0">
            {{#str}} hexcode, qtype_drawing {{/str}}
        </div>
        <div class="col-1">
        </div>
        <div class="col-1">
        </div>
        <div class="col-2 text-center">
            {{#str}} available_student, qtype_drawing {{/str}}
        </div>
        <div class="col-2 text-center">
            {{#str}} available_trainer, qtype_drawing {{/str}}
        </div>
        <div class="col-2 text-center">
            {{#str}} default_student, qtype_drawing {{/str}}
        </div>
        <div class="col-2 text-center">
            {{#str}} default_trainer, qtype_drawing {{/str}}
        </div>
    </div>

    <div data-region="color-rows-container">
    </div>

    <div class="mt-3 mb-4">
        <button type="button" class="btn btn-primary" data-action="add-color">
            {{#str}} add_color, qtype_drawing {{/str}}
        </button>
    </div>

    <div class="form-check mt-2">
        <input class="form-check-input" type="checkbox" id="global_trainer_{{uniqueid}}" data-field="global_trainer">
        <label class="form-check-label" for="global_trainer_{{uniqueid}}">
            {{#str}} global_trainer_avail, qtype_drawing {{/str}}
        </label>
    </div>
    <div class="form-check mt-2">
        <input class="form-check-input" type="checkbox" id="global_student_{{uniqueid}}" data-field="global_student">
        <label class="form-check-label" for="global_student_{{uniqueid}}">
            {{#str}} global_student_avail, qtype_drawing {{/str}}
        </label>
    </div>
</div>
